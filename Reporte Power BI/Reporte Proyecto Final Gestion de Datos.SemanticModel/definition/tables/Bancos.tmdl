	column 'Razón social'
		dataType: string
		lineageTag: 7ef270aa-4d2c-414d-9c99-f1b4b7e11a66
		summarizeBy: none
		sourceColumn: Razón social

		annotation SummarizationSetBy = Automatic

	partition Bancos = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "quejas_bancos.parquet")),
				    Columnas = Table.Distinct(Table.SelectColumns(Origen, {"codigo_entidad", "banco", "es_davivienda"})),
				    Tipos = Table.TransformColumnTypes(Columnas, {{"codigo_entidad", Int64.Type}, {"banco", type text}, {"es_davivienda", type logical}}),
				    // Nombre corto y legible del banco (mismas reglas que el punto 6 del notebook)
				    Especiales = [#"BANCO BILBAO VIZCAYA ARGENTARIA COLOMBIA S.A." = "BBVA Colombia", #"LAMBDA BANK S.A." = "Lambda Bank", #"BANCO COMERCIAL AV VILLAS S.A." = "AV Villas", #"ITAÚ COLOMBIA S.A." = "Itaú"],
				    Corto = (n as text) as text =>
				        let
				            SinSufijo = List.Accumulate({" S.A. BIC", " S.A.", " S.A"}, n, (t, s) => if Text.EndsWith(t, s) then Text.Start(t, Text.Length(t) - Text.Length(s)) else t),
				            Propio = List.Accumulate({{" De ", " de "}, {" Del ", " del "}, {" La ", " la "}, {" Las ", " las "}}, Text.Proper(Text.Trim(SinSufijo)), (s, r) => Text.Replace(s, r{0}, r{1}))
				        in
				            Record.FieldOrDefault(Especiales, n, Propio),
				    ConNombre = Table.AddColumn(Tipos, "Banco", each Corto([banco]), type text),
				    ConGrupo = Table.AddColumn(ConNombre, "Grupo", each if [es_davivienda] then "Davivienda" else "Demás bancos", type text),
				    Final = Table.RenameColumns(Table.SelectColumns(ConGrupo, {"codigo_entidad", "Banco", "Grupo", "banco"}), {{"banco", "Razón social"}})
				in
				    Final

	annotation PBI_ResultType = Table

