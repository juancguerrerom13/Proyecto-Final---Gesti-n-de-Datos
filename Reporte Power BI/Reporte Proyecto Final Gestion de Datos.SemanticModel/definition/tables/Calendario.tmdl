	column 'Mes y año'
		dataType: string
		lineageTag: b9aa0ac6-ccc5-45b5-ae2a-e45a5ac92508
		summarizeBy: none
		sourceColumn: Mes y año
		sortByColumn: fecha

		annotation SummarizationSetBy = Automatic

	column 'Estado del mes'
		dataType: string
		lineageTag: f248e4d7-41bc-4460-bc82-7be436caa56c
		summarizeBy: none
		sourceColumn: Estado del mes

		annotation SummarizationSetBy = Automatic

	partition Calendario = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "calendario.parquet")),
				    Tipos = Table.TransformColumnTypes(Origen, {{"fecha", type date}, {"mes_sin_datos", type logical}, {"mes_incompleto", type logical}, {"mes_completo", type logical}, {"anio_parcial", type logical}}),
				    Anio = Table.AddColumn(Tipos, "Año", each Date.Year([fecha]), Int64.Type),
				    NumMes = Table.AddColumn(Anio, "Número de mes", each Date.Month([fecha]), Int64.Type),
				    // Nombre del mes en español para el segmentador (enero, febrero, ...)
				    NombreMes = Table.AddColumn(NumMes, "Mes", each Text.Proper(Date.ToText([fecha], [Format = "MMMM", Culture = "es-CO"])), type text),
				    MesAnio = Table.AddColumn(NombreMes, "Mes y año", each Date.ToText([fecha], [Format = "MMM yyyy", Culture = "es-CO"]), type text),
				    Estado = Table.AddColumn(MesAnio, "Estado del mes", each if [mes_sin_datos] then "Sin datos" else if [mes_incompleto] then "Incompleto" else "Completo", type text)
				in
				    Estado

	annotation PBI_ResultType = Table

