table Calendario
	lineageTag: 4d476894-6c59-4604-b554-f9795feed4d3

	column fecha
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: c9748756-d9f9-4b8d-9fce-e238d820fc26
		summarizeBy: none
		sourceColumn: fecha

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column mes_sin_datos
		dataType: boolean
		isHidden
		lineageTag: 7410e06d-6cf6-4e7d-9fb9-ba1aa164af4d
		summarizeBy: none
		sourceColumn: mes_sin_datos

		annotation SummarizationSetBy = Automatic

	column mes_incompleto
		dataType: boolean
		isHidden
		lineageTag: bfa2ddfb-6eb6-487c-b0d5-6b10204e7c32
		summarizeBy: none
		sourceColumn: mes_incompleto

		annotation SummarizationSetBy = Automatic

	column mes_completo
		dataType: boolean
		isHidden
		lineageTag: 6cd91336-a10f-424c-8e3b-8aec695fe4b1
		summarizeBy: none
		sourceColumn: mes_completo

		annotation SummarizationSetBy = Automatic

	column anio_parcial
		dataType: boolean
		isHidden
		lineageTag: c5e44c27-d18d-48a6-8131-198760c845c6
		summarizeBy: none
		sourceColumn: anio_parcial

		annotation SummarizationSetBy = Automatic

	column Año
		dataType: int64
		formatString: 0
		lineageTag: f80e22b9-31b5-4c39-a052-e6d7dee5d0a3
		summarizeBy: none
		sourceColumn: Año

		annotation SummarizationSetBy = Automatic

	column 'Mes y año'
		dataType: string
		lineageTag: 5cc4f7a2-3f07-4d75-9a95-df381a83f1a4
		summarizeBy: none
		sourceColumn: Mes y año
		sortByColumn: fecha

		annotation SummarizationSetBy = Automatic

	column 'Estado del mes'
		dataType: string
		lineageTag: 60d2a46f-b99d-4993-8d6b-8c371ee0e140
		summarizeBy: none
		sourceColumn: Estado del mes

		annotation SummarizationSetBy = Automatic

	partition Calendario = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "calendario.parquet")),
				    Tipos = Table.TransformColumnTypes(Origen, {{"fecha", type date}, {"mes_sin_datos", type logical}, {"mes_incompleto", type logical}, {"mes_completo", type logical}, {"anio_parcial", type logical}}),
				    Anio = Table.AddColumn(Tipos, "Año", each Date.Year([fecha]), Int64.Type),
				    Mes = Table.AddColumn(Anio, "Mes y año", each Date.ToText([fecha], [Format = "MMM yyyy", Culture = "es-CO"]), type text),
				    Estado = Table.AddColumn(Mes, "Estado del mes", each if [mes_sin_datos] then "Sin datos" else if [mes_incompleto] then "Incompleto" else "Completo", type text)
				in
				    Estado

	annotation PBI_ResultType = Table

