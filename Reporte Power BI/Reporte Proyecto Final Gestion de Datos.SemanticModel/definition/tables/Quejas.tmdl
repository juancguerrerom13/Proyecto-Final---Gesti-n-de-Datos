table Quejas
	lineageTag: 8556d673-dd7c-443a-a481-6f71ead930a0

	measure 'Total quejas' = SUM(Quejas[Cantidad de quejas])
		formatString: #,0
		displayFolder: Base
		lineageTag: f737bba0-7228-4c59-961d-bd59e9040624

	measure 'Quejas Davivienda' = CALCULATE([Total quejas], KEEPFILTERS(Bancos[Grupo] = "Davivienda"))
		formatString: #,0
		displayFolder: Base
		lineageTag: 3d20b5a4-0fdd-405d-97df-a6c41291e99c

	measure 'Quejas demás bancos' = CALCULATE([Total quejas], KEEPFILTERS(Bancos[Grupo] = "Demás bancos"))
		formatString: #,0
		displayFolder: Base
		lineageTag: ed6e46c6-fe51-42c5-8e5c-d145a35c8582

	measure 'Quejas a bancos analizadas' = CALCULATE([Total quejas], REMOVEFILTERS(Bancos))
		formatString: #,0
		displayFolder: Portada
		lineageTag: fbe41b2c-bdba-4c4d-a9e8-7a13d3f19e19

	measure 'Bancos comparados' = CALCULATE(DISTINCTCOUNT(Bancos[Banco]), REMOVEFILTERS(Bancos))
		formatString: 0
		displayFolder: Portada
		lineageTag: 923a1299-47c1-4376-aa8c-dc776fd89d68

	measure 'Participación entre bancos' = DIVIDE([Quejas Davivienda], CALCULATE([Total quejas], REMOVEFILTERS(Bancos)))
		formatString: 0.0%
		displayFolder: Pregunta 1
		lineageTag: 36d2295a-e03f-432b-b12b-cd59c5775d0d

	measure 'Participación Davivienda' = DIVIDE([Quejas Davivienda], CALCULATE([Total quejas], REMOVEFILTERS(Bancos)))
		formatString: 0.0%
		displayFolder: Pregunta 1
		lineageTag: 3ce64757-f2b2-4cfc-a1c4-1f4f098c6a0e

	measure 'Participación Bancolombia' = DIVIDE(CALCULATE([Total quejas], REMOVEFILTERS(Bancos), Bancos[Banco] = "Bancolombia"), CALCULATE([Total quejas], REMOVEFILTERS(Bancos)))
		formatString: 0.0%
		displayFolder: Pregunta 1
		lineageTag: a1b972c1-4a69-4ebd-86e6-31db0b912ed3

	measure 'Puesto entre bancos' =
			VAR quejasMarca = [Quejas Davivienda]
			RETURN
			    IF(
			        NOT ISBLANK(quejasMarca),
			        COUNTROWS(FILTER(ALL(Bancos), [Total quejas] > quejasMarca)) + 1
			    )
		formatString: 0
		displayFolder: Pregunta 1
		lineageTag: 011f188b-c3be-4580-8183-aa57c116b283

	measure 'Promedio mensual Davivienda' =
			CALCULATE(
			    AVERAGEX(VALUES(Calendario[fecha]), [Quejas Davivienda]),
			    KEEPFILTERS(Calendario[mes_completo] = TRUE())
			)
		formatString: #,0
		displayFolder: Pregunta 1
		lineageTag: 87e02125-1997-40ac-bc65-3e64a34cd7fe

	measure 'Promedio del año' =
			-- Promedio mensual del año calendario (meses completos), como referencia en la serie mensual
			CALCULATE([Promedio mensual Davivienda], ALLEXCEPT(Calendario, Calendario[Año]))
		formatString: #,0
		displayFolder: Pregunta 1
		lineageTag: 2ced35dd-e99e-45b8-bf0d-6b61fc41c487

	measure 'Ingresos Grupo Bolívar' = CALCULATE(SUM(GrupoBolivar[Ingresos operacionales]), TREATAS(VALUES(Calendario[Año]), GrupoBolivar[Año]))
		formatString: 0.00
		displayFolder: Pregunta 1
		lineageTag: 4469dd09-51df-4709-b83f-ac473cff1064

	measure 'Ganancia Grupo Bolívar' = CALCULATE(SUM(GrupoBolivar[Ganancia]), TREATAS(VALUES(Calendario[Año]), GrupoBolivar[Año]))
		formatString: 0.00
		displayFolder: Pregunta 1
		lineageTag: 5c43e4ae-3514-465b-8311-f7e863b0665f

	measure 'Davivienda (% del total)' = DIVIDE([Quejas Davivienda], CALCULATE([Quejas Davivienda], ALLSELECTED(Quejas[Categoría de motivo]), ALLSELECTED(Quejas[Motivo]), ALLSELECTED(Quejas[Familia de producto]), ALLSELECTED(Quejas[Producto]), ALLSELECTED(Quejas[Departamento]), ALLSELECTED(Quejas[Municipio]), ALLSELECTED(Quejas[Instancia])))
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: 9a200403-2b5b-441e-93a5-81a3937d3e15

	measure 'Demás bancos (% del total)' = DIVIDE([Quejas demás bancos], CALCULATE([Quejas demás bancos], ALLSELECTED(Quejas[Categoría de motivo]), ALLSELECTED(Quejas[Motivo]), ALLSELECTED(Quejas[Familia de producto]), ALLSELECTED(Quejas[Producto]), ALLSELECTED(Quejas[Departamento]), ALLSELECTED(Quejas[Municipio]), ALLSELECTED(Quejas[Instancia])))
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: e7557c54-7f55-4637-93a5-dce7fb782d1f

	measure 'Diferencia (pp)' = ([Davivienda (% del total)] - [Demás bancos (% del total)]) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Pregunta 2
		lineageTag: a6e490dd-a1f5-4f45-a03b-0624685ae7c5

	measure '% por fraude y seguridad' = DIVIDE(CALCULATE([Quejas Davivienda], Quejas[Categoría de motivo] = "Fraude y seguridad"), CALCULATE([Quejas Davivienda], REMOVEFILTERS(Quejas[Categoría de motivo])))
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: 0e9a1f77-c4ab-4d00-8374-fce195a4ce7a

	measure 'Fraude Davivienda' = [% por fraude y seguridad]
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: 15da3632-3d19-4ce3-863d-662d37368395

	measure 'Fraude demás bancos' = DIVIDE(CALCULATE([Quejas demás bancos], Quejas[Categoría de motivo] = "Fraude y seguridad"), CALCULATE([Quejas demás bancos], REMOVEFILTERS(Quejas[Categoría de motivo])))
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: 4b427c2d-bce4-429f-961f-c61587a7dfb1

	measure '% tarjetas de crédito' = DIVIDE(CALCULATE([Quejas Davivienda], Quejas[Familia de producto] = "Tarjetas de crédito"), CALCULATE([Quejas Davivienda], REMOVEFILTERS(Quejas[Familia de producto])))
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: 7822b501-c233-4aa8-af03-84e4ea5104c3

	measure 'Tarjetas demás bancos' = DIVIDE(CALCULATE([Quejas demás bancos], Quejas[Familia de producto] = "Tarjetas de crédito"), CALCULATE([Quejas demás bancos], REMOVEFILTERS(Quejas[Familia de producto])))
		formatString: 0.0%
		displayFolder: Pregunta 2
		lineageTag: 655cb617-d1f6-4096-9693-7a4a7ac9b982

	measure '% ante la Superintendencia' = DIVIDE(CALCULATE([Quejas Davivienda], Quejas[Instancia] = "Superintendencia Financiera de Colombia"), CALCULATE([Quejas Davivienda], REMOVEFILTERS(Quejas[Instancia])))
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: a5098fdb-3a78-4fc6-bbf7-cbc7d1558629

	measure 'Ante la SFC Davivienda' = [% ante la Superintendencia]
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: 37be4866-aad7-4fc1-8b7a-5d581f935d8d

	measure 'Ante la SFC demás bancos' = DIVIDE(CALCULATE([Quejas demás bancos], Quejas[Instancia] = "Superintendencia Financiera de Colombia"), CALCULATE([Quejas demás bancos], REMOVEFILTERS(Quejas[Instancia])))
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: 04bfc5fd-a664-4ad6-9f7c-04a3dbf0737c

	measure 'Ante la SFC en 2026' = CALCULATE([% ante la Superintendencia], Calendario[Año] = 2026, Calendario[mes_completo] = TRUE())
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: 496a92bb-d36d-44d0-ba87-2c2bc8178293

	measure '% radicadas en el banco' = DIVIDE(CALCULATE([Quejas Davivienda], Quejas[Instancia] = "Entidad vigilada"), CALCULATE([Quejas Davivienda], REMOVEFILTERS(Quejas[Instancia])))
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: cf8c1ac5-5996-4a8e-b11f-92bb8716438a

	measure '% ante el Defensor' = DIVIDE(CALCULATE([Quejas Davivienda], Quejas[Instancia] = "Defensor del consumidor financiero"), CALCULATE([Quejas Davivienda], REMOVEFILTERS(Quejas[Instancia])))
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: 3f832b69-2920-442a-adf1-f0f6c9cde33e

	measure '% en Bogotá' = DIVIDE(CALCULATE([Quejas Davivienda], Quejas[Departamento] = "BOGOTÁ, D.C."), CALCULATE([Quejas Davivienda], REMOVEFILTERS(Quejas[Departamento])))
		formatString: 0.0%
		displayFolder: Pregunta 3
		lineageTag: 93666068-48cb-4ff2-8929-b90663a6f107

	measure 'Quejas por gran empresa' =
			VAR razon = DIVIDE([Quejas Davivienda], SUM(ContextoDepto[Grandes empresas]))
			VAR puesto = RANKX(ALLSELECTED(ContextoDepto[Departamento]), [Quejas Davivienda])
			-- Solo los 10 departamentos con más quejas, como en el punto 6.9 del notebook
			RETURN IF(puesto <= 10, razon)
		formatString: 0.0
		displayFolder: Pregunta 3
		lineageTag: 97d8d49f-3a42-47a3-b395-479af71a8474

