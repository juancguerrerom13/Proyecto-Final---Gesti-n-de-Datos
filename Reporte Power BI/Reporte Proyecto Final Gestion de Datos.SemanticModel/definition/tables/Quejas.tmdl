	partition Quejas = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "quejas_bancos.parquet")),
				    Columnas = Table.SelectColumns(Origen, {"fecha", "codigo_entidad", "instancia_recepcion", "motivo", "producto", "departamento", "municipio", "cantidad_quejas_recibidas", "familia_producto", "categoria_motivo"}),
				    Tipos = Table.TransformColumnTypes(Columnas, {{"fecha", type date}, {"codigo_entidad", Int64.Type}, {"cantidad_quejas_recibidas", Int64.Type}, {"instancia_recepcion", type text}, {"motivo", type text}, {"producto", type text}, {"departamento", type text}, {"municipio", type text}, {"familia_producto", type text}, {"categoria_motivo", type text}}),
				    Nombres = Table.RenameColumns(Tipos, {{"instancia_recepcion", "Instancia"}, {"motivo", "Motivo"}, {"producto", "Producto"}, {"departamento", "Departamento"}, {"municipio", "Municipio"}, {"cantidad_quejas_recibidas", "Cantidad de quejas"}, {"familia_producto", "Familia de producto"}, {"categoria_motivo", "Categoría de motivo"}})
				in
				    Nombres

	annotation PBI_ResultType = Table

